# ---------------------------------------------------------------------------
# 1) my.telegram.org → API development tools → api_id / api_hash
#    (bot tokeni emas! Kanal tarixini faqat foydalanuvchi sessiyasi o'qiy oladi)
# ---------------------------------------------------------------------------
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
TELEGRAM_SESSION=one23

# Manba kanal: @username yoki -100... id
CHANNEL=

# ---------------------------------------------------------------------------
# 2) Baza va media (bot bilan bir xil papkalar — default qiymatlar to'g'ri)
# ---------------------------------------------------------------------------
SHOP_DB=../data/shop.db
SHOP_UPLOADS=../data/uploads

# ---------------------------------------------------------------------------
# 3) Tahlil qoidalari
# ---------------------------------------------------------------------------
PRICE_USD_RATE=12700          # "$45" kabi narxlarni so'mga o'girish kursi
DEFAULT_CATEGORY=outerwear    # kategoriya aniqlanmasa
REQUIRE_PRICE=true            # narxsiz postlar katalogga chiqmaydi
REQUIRE_MEDIA=false           # rasmsiz postni ham qabul qilish
PUBLISH_ACTIVE=true           # darhol katalogda ko'rinsin
DOWNLOAD_VIDEO=true           # videolarni ham yuklash
MAX_FILE_MB=48                # bundan katta fayl o'tkazib yuboriladi
HISTORY_LIMIT=200             # `sync` uchun standart post soni

# Ochiq kanal username — `web` rejimi uchun (API kalit kerak emas)
CHANNEL_USERNAME=

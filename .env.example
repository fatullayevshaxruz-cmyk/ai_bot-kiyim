# ===== Telegram =====
# BotFather'dan olingan token
BOT_TOKEN=123456789:AA...

# Admin panelga kira oladigan Telegram ID'lar (vergul bilan)
ADMIN_IDS=1233117662

# Buyurtmalar yuboriladigan kanal / guruh (masalan -1003569333780)
ORDERS_CHAT_ID=-100...

# ===== Web App =====
# HTTPS manzil (Telegram Web App faqat https bilan ishlaydi)
PUBLIC_URL=https://shop.example.uz
PORT=8080

# Lokal testda (Telegram tashqarisida) checkout qilish uchun.
# FAQAT localhost uchun ishlaydi. Productionda FALSE qoldiring!
ALLOW_DEV_WEBAPP=false

# ===== Do'kon =====
DELIVERY_FEE=25000
FREE_DELIVERY_FROM=1500000
STORE_ADDRESS=Toshkent sh., Amir Temur ko'chasi 108, 2-qavat
STORE_LANDMARK=Mo'ljal: Amir Temur xiyoboni, Metro "Bunyodkor"
STORE_PHONE=+998875010333
STORE_LOCATION_URL=https://yandex.uz/maps/
SUPPORT_USERNAME=
CHANNEL_URL=
INSTAGRAM_URL=https://instagram.com/standart_bukhara_kritiy

# ===== To'lov =====
# Click: my.click.uz kabinetidan
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
# Click kabinetidagi «Secret key» — callback imzosini tekshirish uchun
CLICK_SECRET_KEY=
# Click Merchant Support’dan tasdiqlangan callback IP manzillarini oling (vergul bilan).
# Bo‘sh bo‘lsa Click to‘lovi ishlamaydi; IP manzillarini taxmin qilib kiritmang.
CLICK_CALLBACK_IPS=
# Payme: business.payme.uz kabinetidan
PAYME_MERCHANT_ID=
# Payme kabinetidagi merchant kaliti (Basic auth paroli)
PAYME_KEY=
# Payme Merchant Support tasdiqlagan callback IP manzillari (vergul bilan).
# Bo‘sh bo‘lsa Payme to‘lovi ishlamaydi; IP manzillarini taxmin qilib kiritmang.
PAYME_CALLBACK_IPS=
